{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api.main:app"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/predict",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/predict/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/graph",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/graph/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/resilience",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/resilience/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/redoc",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}