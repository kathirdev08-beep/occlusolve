{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
  "root": "api",
  "framework": "fastapi",
  "entrypoint": "main:app"
},
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/predict",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/predict/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/graph/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

